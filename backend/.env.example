PORT=5001
NODE_ENV=development

MONGO_URI=mongodb+srv://<DB_USERNAME>:<DB_PASSWORD>@<CLUSTER_URL>/<DATABASE_NAME>?retryWrites=true&w=majority

JWT_SECRET=your_very_long_random_secret
JWT_EXPIRES_IN=7d

# Frontend URL — used for email links (verification, password reset), CORS, and OAuth redirects
CLIENT_URL=http://localhost:5173

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5001/api/auth/google/callback

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Brevo (SendinBlue) API key for transactional email
BREVO_API_KEY=xkeysib-your_brevo_api_key

# Verified sender email for Brevo, e.g., "DevFlow <email@domain.com>"
EMAIL_FROM=DevFlow <your_email@domain.com>

BCRYPT_SALT_ROUNDS=10

COOKIE_SECRET=your_cookie_secret
COOKIE_EXPIRE=7

# API Vault encryption — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=your_base64_encoded_256_bit_key